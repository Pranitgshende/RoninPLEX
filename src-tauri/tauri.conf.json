{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoninPLEX",
  "version": "2.1.1",
  "identifier": "com.roninplex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RoninPLEX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#090a0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Copyright © RoninPLEX. All rights reserved.",
    "category": "Entertainment",
    "shortDescription": "Personal movie and TV discovery & streaming application",
    "longDescription": "RoninPLEX is a modern personal cinema streaming and discovery desktop application for Windows.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "externalBin": [
      "bin/anime-server"
    ]
  }
}
